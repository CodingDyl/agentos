{
  "name": "agentos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n data,web -c yellow,cyan \"npm:dev:data\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:data": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "test": "tsx server/testing/run-tests.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check:rules": "node scripts/checks/repo-rules.mjs",
    "smoke:ollama": "tsx server/route-policy/smoke/ollama-smoke.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "express": "^5.2.1",
    "force-graph": "^1.52.0",
    "framer-motion": "^14.0.0",
    "gray-matter": "^4.0.3",
    "imapflow": "^2.2.5",
    "lucide-react": "^1.41.0",
    "mailparser": "^3.9.36",
    "marked": "^18.0.11",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.0.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.3",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.22.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "gsap": "3.15.1",
    "impeccable": "4.8.0",
    "lenis": "1.3.27",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "minimatch": "^11.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true
  }
}
