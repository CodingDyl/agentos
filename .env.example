# Hermes lives behind the local data adapter. These are read by the Node
# server only — never by Vite, and never exposed to the browser.
#
# Copy to `.env` and fill in your key:  cp .env.example .env
HERMES_BASE_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=
HERMES_MODEL=hermes

# Grok Build runs coding jobs as a worker. On a personal machine an existing
# `grok login` session is enough and none of these are needed.
#
# XAI_API_KEY makes a headless setup deterministic — it is read by the Node
# server and passed to the Grok process only, never by Vite and never exposed
# to the browser.
# XAI_API_KEY=

# Where the grok binary lives, if it is not on PATH.
# AGENTOS_GROK_BIN=grok

# Sandbox profile for worker runs. `workspace` confines writes to the job's
# worktree. `strict` is tighter but refuses to start on machines where a denied
# runtime socket is a symlink (Docker Desktop on macOS). `off` disables it.
# AGENTOS_GROK_SANDBOX=workspace

# Let a worker reach the network. Off by default.
# AGENTOS_GROK_ALLOW_WEB=1

# Bounds on one run.
# AGENTOS_GROK_MAX_TURNS=40
# AGENTOS_GROK_TIMEOUT_MS=1800000

# Claude runs coding jobs as a worker, through the Agent SDK.
#
# A key is required rather than optional: the worker runs in its own
# configuration directory, so an interactive `claude login` on this machine is
# deliberately not visible to it. Read by the Node server only — never by Vite,
# and never exposed to the browser.
# ANTHROPIC_API_KEY=

# The model alias to run. An alias rather than a dated model ID, so the worker
# follows the current release instead of pinning to one that will age out.
# CLAUDE_WORKER_MODEL=sonnet

# Bounds on one run. The budget is a hard ceiling: the run stops when it is
# spent, and what it did up to that point still goes to validation and review.
# CLAUDE_WORKER_MAX_TURNS=30
# CLAUDE_WORKER_MAX_BUDGET_USD=3
# CLAUDE_WORKER_TIMEOUT_MS=1800000

# Where the worker keeps its own Claude configuration. Deliberately not
# `~/.claude` — that directory is the operator's, and a worker that read it
# would inherit skills, memory, and MCP servers the job never asked for.
# CLAUDE_WORKER_CONFIG_DIR=~/.agentos-worker/claude

# Mail: Gmail (read-only) + Jev classification.
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET come from a Google Cloud OAuth
# client (type: Desktop app). Read by the Node server only — never by Vite,
# and never exposed to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where the browser is sent back to after completing Google's consent
# screen. Defaults to the Vite dev server's own address; only used for that
# one redirect.
# AGENTOS_WEB_ORIGIN=http://127.0.0.1:1420

# TypeSafe's Jev, used to classify each new mail thread. Read by the Node
# server only.
JEV_API_KEY=
